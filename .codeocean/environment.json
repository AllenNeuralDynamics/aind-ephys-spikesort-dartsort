{
	"version": 1,
	"base_image": "codeocean/cuda12-runtime-uv:main-5692e50",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "libtbb-dev",
					"version": "2021.11.0-2ubuntu2"
				}
			],
			"install_software_properties_common": true
		},
		"pip": {
			"packages": [
				{
					"name": "aind-data-schema",
					"version": "2.8.1"
				},
				{
					"name": "dartsort",
					"version": "0.5.31"
				},
				{
					"name": "log-schema",
					"version": "0.2.10.dev1"
				},
				{
					"name": "scipy",
					"version": "1.17.1"
				},
				{
					"name": "spikeinterface[full]",
					"version": "0.105.4"
				},
				{
					"name": "torch",
					"version": "2.13.0"
				},
				{
					"name": "torchaudio",
					"version": "2.11.0"
				},
				{
					"name": "torchvision",
					"version": "0.28.0"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	},
	"env_variables": [
		{
			"name": "NUMBA_THREADING_LAYER",
			"value": "tbb"
		}
	]
}