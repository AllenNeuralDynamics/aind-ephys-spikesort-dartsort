{
    "logging": {
        "package": "log-schema"
    },
    "spikesorting": {
        "dartsort": {
            "job_kwargs": {
                "chunk_duration": "1s",
                "progress_bar": false
                },
            "sorter": {
                "preprocessing": "standardize",
                "work_in_tmpdir": true,
                "tmpdir_parent": "../scratch",
                "copy_recording_to_tmpdir": "no",
                "motion_batching_mode": "online",
                "save_intermediates": true
            }
        }
    }
}
